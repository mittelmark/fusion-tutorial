public static class Stats {
	static double Mean (List<double> x) {
		double sum = 0.0;
		int n = 0;
		for (int i = 0; i < x.Count; i++) {
			if (!Math.IsNaN(x[i])) {
				sum = sum + x[i];
				n = n + 1 ;
			}
			
		}
		return(sum/n);
	}
	static List<bool>() IsNa (List<double> x) {
		List<bool>() b;
		for (int i = 0; i < x.Count; i++) {
			if (Math.IsNaN(x[i])) {
				b.Add(true);
			} else {
				b.Add(false);
			}
		}
		return(b);
	}
	static List<int>() Which (List<bool> b) {
		List<int>() w ;
		for (int i = 0; i < b.Count; i++) {
			if (b[i] == true) {
				w.Add(i);
			}
		}
		return(w);
	}
	public static void Main (string[] args) {
		List<double>() x ;
		x.Add(0.2);
		x.Add(0.5);
		x.Add(0.9);
		x.Add(Math.NaN);
		x.Add(2.2);
		x.Add(Math.NaN);
		double m = Stats.Mean(x);
		Console.WriteLine($"mean is {m}");
		List<int>() nas = Stats.Which(Stats.IsNa(x));
		for (int i = 0; i < nas.Count; i++) {
			Console.WriteLine($"On position {nas[i]} the numeric value is NA!");
		}
	}
}
