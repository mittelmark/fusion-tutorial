public class IntMatrix {
	List<List<int>()>() M;
	int nc = 0;
	int nr = 0;
	public void create! (int nrow, int ncol, int value=0) {
		for (int i = 0; i < nrow; i++) {
			M.Add();
			for (int j = 0; j < ncol; j++) {
				M[i].Add(value);
			}
		}
		nc = ncol;
		nr = nrow;
	}
	public void set!(int row,int col,int value) {
		M[row][col]= value;
	}
	public int get(int row,int col) {
		return(M[row][col]);
	}
	public List<int> getRow(int row) {
		return(M[0]);
	}
	public List<int>() getColumn(int col) {
		List<int>() values;
		for (int i = 0; i < nr; i++) {
			values.Add(M[i][col]);
		}
		return(values);
	}
	public int nrow() => nr;
	public int ncol() => nc;
	public static void Main (string[] args) {
		IntMatrix() N;
		N.create(4,4,0);
		N.set(1,2,1);
		Console.WriteLine($"Nrow={N.nrow()} - ncol={N.ncol()}");
		for (int i = 0; i < N.nrow(); i++) {
			for (int j = 0; j < N.ncol(); j++) {
				Console.Write($"{N.get(i,j)}\t");
			}
			Console.WriteLine("");
		}
		Console.WriteLine("################################");
		List<int> x = N.getColumn(2);
		for (int i = 0; i < x.Count; i++) {
			Console.Write($"{x[i]}\t");
		}
		Console.WriteLine("");
		
	}
}


